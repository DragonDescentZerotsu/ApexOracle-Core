#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
CAPSULE_DIR=$(cd "${SCRIPT_DIR}/.." && pwd)

if [[ "${1:-}" == "fig2b" || "${1:-}" == "fig2b-mic" || "${1:-}" == "fig2b_mic" ]]; then
  shift
fi

python "${SCRIPT_DIR}/reproduce_fig2b_mic_regression.py" \
  --data-root "${CAPSULE_DIR}/data" \
  --results-dir "${CAPSULE_DIR}/results" \
  "$@"
