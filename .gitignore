# Reviewer-facing audit tables are intentionally versioned. Keep the global
# binary/data exclusions above, then allow only these documented outputs.
!experiments/peplink_validation/chatgpt_opsin_manual_review.csv
!experiments/peplink_validation/chatgpt_opsin_chemical_validation.csv
!experiments/peplink_validation/recalculated_local_error_peptides.csv
